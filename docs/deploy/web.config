<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS site for Notionix: HTTPS (company certificate, bound in IIS) is
  terminated here and forwarded to the container on 127.0.0.1:8080.
  Requires: URL Rewrite, Application Request Routing (proxy enabled),
  and the "WebSocket Protocol" Windows feature.
-->
<configuration>
  <system.webServer>
    <webSocket enabled="false" /><!-- WebSockets are proxied by ARR, not handled by IIS itself -->
    <rewrite>
      <rules>
        <rule name="Notionix" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8080/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>
      </rules>
      <allowedServerVariables>
        <add name="HTTP_X_FORWARDED_PROTO" />
      </allowedServerVariables>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- Images up to 50 MB (the server refuses larger ones). -->
        <requestLimits maxAllowedContentLength="62914560" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
